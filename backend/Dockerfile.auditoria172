# Imagen sólo para ensayos #172: sin entrypoint, collectstatic ni settings en build.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY manage.py .
COPY config/ ./config/
COPY apps/ ./apps/
RUN mkdir -p /laboratorio/media /laboratorio/privado/facturas \
    && chown -R 10001:10001 /laboratorio
USER 10001:10001
ENTRYPOINT ["python"]
CMD ["manage.py", "check"]
