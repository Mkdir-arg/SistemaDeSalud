# URL base de la API. En dev se usa el proxy de Vite (/api → :8000),
# así que normalmente no hace falta tocar esto.
VITE_API_URL=/api
# Opcionales: usar contactos oficiales verificados para la recuperación asistida.
# VITE_SOPORTE_EMAIL=soporte@institucion.gob.ar
# VITE_SOPORTE_URL=https://institucion.gob.ar/soporte
# Opcionales de la landing pública: sin valor, el enlace no se muestra.
# «Solicitar una demo» acepta https:// o mailto:; los legales, solo https://.
# El correo de soporte del pie reutiliza VITE_SOPORTE_EMAIL.
# VITE_DEMO_URL=mailto:demo@institucion.gob.ar
# VITE_TERMINOS_URL=https://institucion.gob.ar/terminos
# VITE_PRIVACIDAD_URL=https://institucion.gob.ar/privacidad
# VITE_ACCESIBILIDAD_URL=https://institucion.gob.ar/accesibilidad
# Minutos sin interacción humana antes del bloqueo de la interfaz (predeterminado: 15).
# VITE_IDLE_LOCK_MINUTES=15
