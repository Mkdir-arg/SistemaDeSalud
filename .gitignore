# === Python / Django (backend) ===
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Base de datos local de desarrollo (no versionar)
*.sqlite3
backend/db.sqlite3

# Dumps, respaldos y temporales con posible informacion sensible
*.sql
*.sql.gz
*.dump
*.backup
*.bak
*.sqlite3.gz
backend/C*/Users/
backend/**/Temp/

# Copias accidentales de paquetes dentro del backend real
/backend/backend/

# Estáticos recolectados y archivos subidos por usuarios
backend/staticfiles/
backend/media/
!backend/media/.gitkeep

# === Node / Vite (frontend) ===
node_modules/
frontend/dist/
*.local

# === Playwright (artefactos de las corridas, no la suite) ===
frontend/test-results/
# Playwright a veces escribe en la raíz según desde dónde se lo invoque.
/test-results/
/playwright-report/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# === Variables de entorno (solo se versiona .env.example) ===
.env
.env.*
!.env.example

# === Editores / SO ===
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# === Logs ===
*.log
npm-debug.log*

# === Claude Code (config local de la sesión) ===
.claude/

# Esquema OpenAPI generado. No se versiona: comiteado se vuelve mentira
# apenas cambie un endpoint. Se sirve en /api/esquema/ y hay un test que
# verifica que se genere limpio.
backend/esquema.yml
