# Copiá este archivo a .env y ajustá lo que necesites.
# docker compose lee .env automáticamente.
#
# Lo marcado [PRODUCCIÓN] hay que definirlo sí o sí antes de exponer el sistema.
# Ver docs/DESPLIEGUE.md.


# --- Puerto público de la app (nginx del frontend) -------------------------
WEB_PORT=8080


# --- Base de datos ---------------------------------------------------------
# Las tres de abajo las usa el contenedor de Postgres del compose.
POSTGRES_DB=salud
POSTGRES_USER=salud
POSTGRES_PASSWORD=salud

# [PRODUCCIÓN] Lo que usa Django para conectarse.
#
# SIN ESTA VARIABLE EL SISTEMA CAE A SQLITE EN SILENCIO. No falla, no avisa:
# arranca contra un archivo local y parece andar hasta que alguien busca los datos.
# El compose la arma sola a partir de las tres de arriba; fuera del compose hay que
# definirla a mano.
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# TLS contra la base. Por defecto TRUE: un Postgres administrado (Supabase, RDS)
# lo exige. Ponelo en false sólo si la base está en la misma red privada.
# DATABASE_SSL=true


# --- Django ----------------------------------------------------------------
# [PRODUCCIÓN] Con DEBUG=true Django sirve /media y /static y muestra trazas
# completas ante un error. Nunca en un sistema con datos de pacientes.
DJANGO_DEBUG=false

# [PRODUCCIÓN] Generá una nueva. La de este archivo es un ejemplo, no un secreto:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion

# [PRODUCCIÓN] Los dominios desde los que se sirve. Sin el dominio real acá,
# Django rechaza toda petición con 400.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# [PRODUCCIÓN] Orígenes del navegador autorizados a llamar a la API.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080


# --- Seguridad del transporte ----------------------------------------------
# Las dos siguientes SÓLO tienen efecto con DJANGO_DEBUG=false.
#
# Redirigir todo a HTTPS. Por defecto TRUE, que es lo correcto en producción.
# En local no hay certificado, así que los entornos de docs/entornos/ lo apagan.
#
# OJO EN LOS TESTS: con esto activo, todas las pruebas de API reciben un 301 y
# aparecen cientos de fallas que no son reales. Ver docs/PRUEBAS.md.
# DJANGO_SSL_REDIRECT=true

# HSTS. Por defecto UN AÑO, con subdominios y preload.
#
# Es difícil de revertir: si el navegador lo recibe para `localhost`, te fuerza
# https en localhost para TODOS tus proyectos locales, y volver atrás exige limpiar
# el estado HSTS del navegador. Por eso en local va en 0.
# DJANGO_HSTS_SECONDS=31536000


# --- Integraciones salientes -----------------------------------------------
# Lista blanca de hosts a los que un nodo de flujo puede llamar (por ejemplo, un
# padrón FHIR externo). Separados por coma.
#
# VIENE VACÍA: la función está APAGADA hasta que se habilite cada host a
# conciencia. Es una decisión de infraestructura, no del diseñador del flujo.
#
# Se resuelve con lista blanca y no bloqueando rangos privados porque el DNS puede
# cambiar de respuesta entre la validación y la petición.
# SALUD_INTEGRACIONES_PERMITIDAS=padron.salud.gob.ar,fhir.otroefector.gob.ar

# Tope de espera de una llamada externa, en segundos. El motor la hace en línea,
# así que un servicio lento cuelga el avance del caso.
# SALUD_INTEGRACIONES_TIMEOUT=6


# --- Siembra de datos ------------------------------------------------------
# Sólo para entornos de prueba. En producción las dos van en 0.
#
# SEED_DEMO   escenario de demo genérico.
# SEED_GUARDIA  escenario de guardia (lo que usa el override de desarrollo).
#
# Siembran únicamente si la base está vacía.
SEED_DEMO=0
SEED_GUARDIA=1


# --- Procesos de fondo -----------------------------------------------------
# Sólo `backend` aplica migraciones; los demás contenedores esperan a que termine.
# Cuatro contenedores de la misma imagen corriendo `migrate` a la vez toman locks
# de DDL en distinto orden y la migración puede quedar a mitad de camino.
# Lo fija el compose; no hace falta tocarlo salvo en un despliegue propio.
# EJECUTAR_MIGRACIONES=1
